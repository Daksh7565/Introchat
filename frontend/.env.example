# Copy to .env.local for local development (never committed).
#
# Every VITE_* value is compiled into the JavaScript that every guest's phone
# downloads, so ONLY public values may go here. Never put the Supabase
# service_role key, a Razorpay key secret, or any other secret in a VITE_ variable.
#
# On Cloudflare Pages the same variables are set per environment
# (Settings → Variables and Secrets), not from this file.

# Supabase project: Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry error reporting. Empty = reporting off (normal locally).
VITE_SENTRY_DSN=
# Environment name shown in Sentry: local | preview | production
VITE_APP_ENV=local

# Address printed inside every table QR code: origin only, https in production.
# Until the domain is bought this is the Cloudflare Pages address; cards printed
# with it must be reprinted after the switch.
VITE_PUBLIC_APP_URL=http://localhost:5173

# Web push: the PUBLIC half of the project's VAPID key pair (the private half is
# an Edge Function secret, never here). Empty = notifications are not offered.
VITE_VAPID_PUBLIC_KEY=
