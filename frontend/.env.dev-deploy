# Public settings for the dev deployment (npm run deploy:dev). Committed on
# purpose: both values are public, and they must match the deployed address or
# printed QR cards point nowhere. Supabase URL and anon key come from .env.local.
VITE_PUBLIC_APP_URL=https://introchat-dev.introchat-frontend.workers.dev
VITE_APP_ENV=preview
