# Dependencies
node_modules/

# Build output
dist/
dev-dist/
# Local wrangler dev state (serving dist/ to test the CSP)
.wrangler/
*.tsbuildinfo

# Test output
coverage/
playwright-report/
test-results/

# Environment files: only .env.example and .env.dev-deploy (public values of
# the dev deployment: its address and environment name) are committed. Secrets
# never live in any VITE_* file.
.env
.env.*
!.env.example
!.env.dev-deploy

# Supabase CLI local state (project link, temp files). Never commit: it holds
# the linked project ref and can hold access tokens.
supabase/.temp/
supabase/.branches/

# Field-test raw data can contain precise coordinates of real people's phones.
# Only the summarised results go into the plan documents.
documents/field-tests/raw/

# Personal notes and local Claude Code commands: kept on this machine only.
t.txt
.claude/

# Logs and OS / editor noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
